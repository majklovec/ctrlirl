#!/bin/bash
# CtrlIRL — stav komponent: client, SRTLA, modemy, OBS, LAN IP, CPU

set -o pipefail

GREEN='\e[92m'; RED='\e[91m'; YELLOW='\e[93m'; CYAN='\e[96m'; RESET='\e[0m'
on()   { printf "${GREEN}● %s${RESET}" "$1"; }
off()  { printf "${RED}● %s${RESET}"   "$1"; }
warn() { printf "${YELLOW}● %s${RESET}" "$1"; }

# --- CtrlIRL client ---
CS="off"; CL="Neběží"
for svc in ctrlirl-client ctrlirl client; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        CS="on"; CL="Běží ($svc)"; break
    fi
done
if [[ "$CS" == "off" ]] && pgrep -f 'bun.*client\.ts' >/dev/null 2>&1; then
    CS="on"; CL="Běží (proces)"
fi

# --- SRTLA ---
SS="off"; SL="Neběží"
if pgrep -f 'srtla_send' >/dev/null 2>&1; then
    SS="on"; SL="Běží"
elif systemctl is-active --quiet srtla       2>/dev/null \
  || systemctl is-active --quiet srtla-send  2>/dev/null; then
    SS="on"; SL="Běží (služba)"
fi

# --- Modemy (ModemManager) ---
MODEMS=0
if command -v mmcli >/dev/null 2>&1; then
    MODEMS=$(mmcli -L 2>/dev/null | grep -c 'Modem/' || true)
fi

# --- OBS WebSocket (výchozí port 4455) ---
OS="off"; OL="Nepřipojeno"
if command -v ss >/dev/null 2>&1 && ss -tln 2>/dev/null | grep -q ':4455 '; then
    OS="on"; OL="WebSocket aktivní"
fi

# --- LAN IP ---
LAN_IP="$(ip -4 -o addr show scope global 2>/dev/null \
         | awk '{print $4}' | cut -d/ -f1 | head -1)"

# --- CPU teplota ---
CPU_TEMP=""
for tz in /sys/class/thermal/thermal_zone*/temp; do
    if [[ -r "$tz" ]]; then
        t=$(( $(cat "$tz") / 1000 ))
        if (( t > 0 && t < 150 )); then CPU_TEMP="${t}°C"; break; fi
    fi
done

# --- výstup ---
echo ""
printf " ${CYAN}CtrlIRL stav:${RESET}\n"
printf "  Client:   %s\n" "$([[ "$CS" == "on" ]] && on "$CL" || off "$CL")"
printf "  SRTLA:    %s\n" "$([[ "$SS" == "on" ]] && on "$SL" || off "$SL")"
if (( MODEMS > 0 )); then
    printf "  Modemy:   %s\n" "$(on "$MODEMS připojeny")"
else
    printf "  Modemy:   %s\n" "$(warn "žádný")"
fi
printf "  OBS:      %s\n" "$([[ "$OS" == "on" ]] && on "$OL" || warn "$OL")"
printf "  LAN IP:   %s\n" "${LAN_IP:-N/A}"
[[ -n "$CPU_TEMP" ]] && printf "  CPU:      %s\n" "$CPU_TEMP"
