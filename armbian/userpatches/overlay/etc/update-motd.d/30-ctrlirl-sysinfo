#!/bin/bash
# Minimální přehled: uptime, load, RAM, disk

UPTIME="$(uptime -p 2>/dev/null | sed 's/^up //')"
LOAD="$(awk '{print $1}' /proc/loadavg)"
MEM="$(free -m | awk 'NR==2{ if ($2>0) printf "%.0f%%", $3/$2*100; else print "n/a" }')"
DISK="$(df -h / | awk 'NR==2{print $5}')"

echo ""
printf " \e[0;90mSystém:  \e[0m"
printf "Uptime: \e[92m%s\e[0m" "${UPTIME:-n/a}"
printf "  Load: \e[92m%s\e[0m" "$LOAD"
printf "  RAM: \e[92m%s\e[0m"  "$MEM"
printf "  Disk: \e[92m%s\e[0m\n" "$DISK"
